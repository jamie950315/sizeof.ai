{
  "$comment": "Approved terminology for every locale. `match` finds the English term in a source message; `use` is the approved rendering a translator writes; `accept` is the inflection-aware pattern the test requires in the translation; `avoid` lists known wrong variants. Patterns are case-insensitive and run on text with Arabic diacritics, tatweel and Devanagari nukta removed. `except` lists English messages where the word is an identifier or carries a different meaning. See src/i18n/GLOSSARY.md.",
  "style": {
    "zh-TW": {
      "register": "Address the reader as 你, never 您. Use Taiwan terminology and full-width punctuation around Chinese text.",
      "avoid": [
        {
          "pattern": "您",
          "reason": "Use 你."
        },
        {
          "pattern": "默認|缺省",
          "reason": "Use 預設."
        },
        {
          "pattern": "內存|内存|顯存",
          "reason": "Use 記憶體 or VRAM."
        },
        {
          "pattern": "緩存",
          "reason": "Use 快取."
        },
        {
          "pattern": "服務器|服务器",
          "reason": "Use 伺服器."
        },
        {
          "pattern": "軟件|硬件",
          "reason": "Use 軟體 / 硬體."
        },
        {
          "pattern": "數據庫",
          "reason": "Use 資料庫."
        },
        {
          "pattern": "網絡",
          "reason": "Use 網路."
        },
        {
          "pattern": "加載",
          "reason": "Use 載入."
        },
        {
          "pattern": "信息",
          "reason": "Use 資訊 or 訊息."
        },
        {
          "pattern": "用戶(?!端)",
          "reason": "Use 使用者."
        },
        {
          "pattern": "設置",
          "reason": "Use 設定."
        },
        {
          "pattern": "鏈接|链接",
          "reason": "Use 連結."
        },
        {
          "pattern": "視頻",
          "reason": "Use 影片."
        },
        {
          "pattern": "屏幕",
          "reason": "Use 螢幕."
        },
        {
          "pattern": "運行時|运行时",
          "reason": "Use 執行階段 or 執行環境."
        },
        {
          "pattern": "[这们来时为说对会发开关还进过应该实现网络数据库软显记忆体缓设运]",
          "reason": "Simplified Chinese character in a Traditional Chinese catalog."
        }
      ]
    },
    "zh-CN": {
      "register": "Address the reader as 你, never 您. Use mainland terminology.",
      "avoid": [
        {
          "pattern": "您",
          "reason": "Use 你."
        },
        {
          "pattern": "記憶體|记忆体|快取",
          "reason": "Use 内存 / 显存 / 缓存."
        },
        {
          "pattern": "伺服器",
          "reason": "Use 服务器."
        },
        {
          "pattern": "軟體|软体|硬體|硬体",
          "reason": "Use 软件 / 硬件."
        },
        {
          "pattern": "預設|预设值",
          "reason": "Use 默认."
        },
        {
          "pattern": "[這們來時為說對會發開關還進過應該實現網絡數據庫軟體顯記憶設執]",
          "reason": "Traditional Chinese character in a Simplified Chinese catalog."
        }
      ]
    },
    "ja": {
      "register": "Polite です/ます style for sentences; noun phrases for buttons and labels.",
      "avoid": [
        {
          "pattern": "パラメーター",
          "reason": "Use パラメータ."
        }
      ]
    },
    "ko": {
      "register": "Polite 합니다/하세요 style; noun phrases for buttons and labels.",
      "avoid": []
    },
    "es": {
      "register": "Address the reader as usted (su, sus, verifique). Never tú.",
      "avoid": [
        {
          "pattern": "\\b(?:tu|tus|tú|ti|contigo|puedes|quieres|necesitas|tienes)\\b",
          "reason": "Use the usted register."
        }
      ]
    },
    "pt": {
      "register": "Brazilian Portuguese with você.",
      "avoid": [
        {
          "pattern": "\\b(?:teu|teus|tua|tuas|vós)\\b",
          "reason": "Use você."
        },
        {
          "pattern": "\\b(?:ficheiro|ecrã|utilizador)",
          "reason": "European Portuguese; use arquivo / tela / usuário."
        }
      ]
    },
    "fr": {
      "register": "Address the reader as vous. Use a non-breaking space before : ; ? !",
      "avoid": [
        {
          "pattern": "\\b(?:tu|ton|ta|tes|toi)\\b",
          "reason": "Use vous."
        }
      ]
    },
    "de": {
      "register": "Address the reader as Sie. Buttons use the infinitive (\"Datei verwenden\"), not an imperative sentence.",
      "avoid": [
        {
          "pattern": "\\b(?:du|dein|deine|deinen|deinem|deiner)\\b",
          "reason": "Use Sie."
        }
      ]
    },
    "ru": {
      "register": "Address the reader as вы (lowercase in running text). Buttons use the infinitive.",
      "avoid": [
        {
          "pattern": "(?:^|[^а-яё])(?:ты|твой|твоя|твоё|твои)(?:$|[^а-яё])",
          "reason": "Use вы."
        }
      ]
    },
    "ar": {
      "register": "Modern Standard Arabic, second person singular imperative for instructions.",
      "avoid": []
    },
    "hi": {
      "register": "आप register. Common English technical terms are transliterated (मेमोरी, कॉन्टेक्स्ट, टोकन).",
      "avoid": []
    },
    "id": {
      "register": "Formal Anda register.",
      "avoid": [
        {
          "pattern": "\\b(?:kamu|kau|engkau)\\b",
          "reason": "Use Anda."
        }
      ]
    }
  },
