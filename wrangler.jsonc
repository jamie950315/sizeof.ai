{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sizeof-ai",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "kv_namespaces": [
    { "binding": "MODEL_CACHE", "id": "64daa9eb377a4098969912297dbecbef" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "routes": [
    { "pattern": "sizeof.ai", "custom_domain": true },
    { "pattern": "www.sizeof.ai", "custom_domain": true }
  ],
  "env": {
    "testnet": {
      "name": "sizeof-ai-testnet",
      "vars": {
        "ENVIRONMENT": "testnet",
        "HF_ENTERPRISE_KEYS_ENABLED": "true",
        "SIZEOF_SEARCH_JP_URL": "https://ccsearch.0ruka.dev/__sizeof_index",
        "SIZEOF_SEARCH_US_URL": "https://sizeof-search-us.0ruka.dev"
      },
      "kv_namespaces": [
        { "binding": "MODEL_CACHE", "id": "0a07ede1f0744dd696857d5bea6d2441" }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/assets/*", "!/favicon*", "!/apple-touch-icon.png"]
      },
      "routes": [
        { "pattern": "testnet.sizeof.ai", "custom_domain": true }
      ]
    }
  }
}
